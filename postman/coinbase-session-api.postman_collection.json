              "raw": "{\n  \"destination_wallets\": [\n    {\n      \"address\": \"<string>\",\n      \"blockchains\": [\n        \"<string>\",\n        \"<string>\"\n      ],\n      \"assets\": [\n        \"<string>\",\n        \"<string>\"\n      ],\n      \"supported_networks\": [\n        \"<string>\",\n        \"<string>\"\n      ]\n    },\n    {\n      \"address\": \"<string>\",\n      \"blockchains\": [\n        \"<string>\",\n        \"<string>\"\n      ],\n      \"assets\": [\n        \"<string>\",\n        \"<string>\"\n      ],\n      \"supported_networks\": [\n        \"<string>\",\n        \"<string>\"\n      ]\n    }\n  ]\n}",
