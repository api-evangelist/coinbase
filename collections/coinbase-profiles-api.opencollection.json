{
  "opencollection": "1.0.0",
  "info": {
    "name": "Coinbase Advanced Trade Accounts Profiles API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "CB-ACCESS-KEY",
      "value": "{{CB-ACCESS-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Profiles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List profiles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coinbase.com/api/v3/brokerage/profiles",
            "params": [
              {
                "name": "active",
                "value": "",
                "type": "query",
                "description": "Filter for active profiles only"
              }
            ]
          },
          "docs": "Retrieves a list of trading profiles for the authenticated user. Profiles are used to separate trading activity."
        },
        {
          "info": {
            "name": "Get profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coinbase.com/api/v3/brokerage/profiles/:profile_id",
            "params": [
              {
                "name": "profile_id",
                "value": "",
                "type": "path",
                "description": "Profile ID"
              }
            ]
          },
          "docs": "Retrieves a single profile by its profile ID."
        },
        {
          "info": {
            "name": "Transfer between profiles",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.coinbase.com/api/v3/brokerage/profiles/transfer",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Transfers an amount of currency from one profile to another."
        }
      ]
    }
  ],
  "bundled": true
}