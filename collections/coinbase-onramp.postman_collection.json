    "_postman_id": "b4a63a9e-6ce3-4099-bee0-d6185949229d",
    "name": "Coinbase Onramp API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Coinbase Onramp API allows developers to integrate fiat-to-crypto purchasing and crypto-to-fiat selling directly into their applications. It provides REST APIs to discover available buy and sell options, generate price quotes, create one-click-buy URLs, and manage session tokens for embedded onramp experiences. The API supports multiple fiat currencies and payment methods.\n\nContact Support:\n Name: Coinbase Developer Support",
      "type": "text/plain"
    }
  }
