{
  "opencollection": "1.0.0",
  "info": {
    "name": "Coinbase Advanced Trade Accounts Session API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "CB-ACCESS-KEY",
      "value": "{{CB-ACCESS-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Session",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create session token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.coinbase.com/api/v3/brokerage/token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a session token for authenticating the embedded onramp widget. The token is used to initialize the Coinbase Onramp widget within a third-party application."
        }
      ]
    }
  ],
  "bundled": true
}