{
  "opencollection": "1.0.0",
  "info": {
    "name": "Coinbase Exchange API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "CB-ACCESS-KEY",
      "value": "{{CB-ACCESS-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/accounts"
          },
          "docs": "Retrieves a list of trading accounts associated with the authenticated user. Each account holds a specific currency and shows available and hold balances."
        },
        {
          "info": {
            "name": "Get account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/accounts/:account_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Account identifier"
              }
            ]
          },
          "docs": "Retrieves information for a single exchange account by its account ID. Returns the current balance, available funds, and hold amounts."
        },
        {
          "info": {
            "name": "Get account ledger",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/accounts/:account_id/ledger",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Account identifier"
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination (newer items)"
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination (older items)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results per request (max 100)"
              }
            ]
          },
          "docs": "Retrieves the ledger (transaction history) for a specific account. Returns a paginated list of account activity entries."
        },
        {
          "info": {
            "name": "Get account holds",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/accounts/:account_id/holds",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Account identifier"
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination (newer items)"
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination (older items)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results per request (max 100)"
              }
            ]
          },
          "docs": "Retrieves holds on an account that are associated with active orders or pending withdraw requests. Holds make funds unavailable for trading."
        },
        {
          "info": {
            "name": "Get account transfers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/accounts/:account_id/transfers",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Account identifier"
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination (newer items)"
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination (older items)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results per request (max 100)"
              }
            ]
          },
          "docs": "Retrieves a list of in-progress and completed transfers of funds to or from the account."
        }
      ]
    },
    {
      "info": {
        "name": "Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/orders",
            "params": [
              {
                "name": "product_id",
                "value": "",
                "type": "query",
                "description": "Filter orders by product ID"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by order status"
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination (newer items)"
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination (older items)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results per request (max 100)"
              }
            ]
          },
          "docs": "Retrieves a list of recent orders for the authenticated user. Supports filtering by product, status, and date range. Returns a paginated list sorted by creation time."
        },
        {
          "info": {
            "name": "Create order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.exchange.coinbase.com/orders",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Places a new order on the exchange. Supports market, limit, and stop order types. The request body must include the product ID, side, and order-specific parameters."
        },
        {
          "info": {
            "name": "Cancel all orders",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.exchange.coinbase.com/orders",
            "params": [
              {
                "name": "product_id",
                "value": "",
                "type": "query",
                "description": "Only cancel orders for this product"
              }
            ]
          },
          "docs": "Cancels all open orders on the exchange. Optionally filter by product ID to cancel orders for a specific trading pair only."
        },
        {
          "info": {
            "name": "Get order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/orders/:order_id",
            "params": [
              {
                "name": "order_id",
                "value": "",
                "type": "path",
                "description": "Order ID"
              }
            ]
          },
          "docs": "Retrieves a single order by its order ID. Returns the full order details including status, filled size, and execution price."
        },
        {
          "info": {
            "name": "Cancel order",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.exchange.coinbase.com/orders/:order_id",
            "params": [
              {
                "name": "order_id",
                "value": "",
                "type": "path",
                "description": "Order ID to cancel"
              }
            ]
          },
          "docs": "Cancels a previously placed order by its ID. The order must still be in an open or pending state."
        },
        {
          "info": {
            "name": "List fills",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/fills",
            "params": [
              {
                "name": "order_id",
                "value": "",
                "type": "query",
                "description": "Filter fills by order ID"
              },
              {
                "name": "product_id",
                "value": "",
                "type": "query",
                "description": "Filter fills by product ID"
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination (newer items)"
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination (older items)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results per request (max 100)"
              }
            ]
          },
          "docs": "Retrieves a list of recent fills for the authenticated user. Fills represent the settlement of an order at a specific price and quantity."
        }
      ]
    },
    {
      "info": {
        "name": "Products",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List products",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/products"
          },
          "docs": "Retrieves a list of available trading products on the exchange. Returns details about each trading pair including base and quote currencies, trading limits, and status."
        },
        {
          "info": {
            "name": "Get product",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/products/:product_id",
            "params": [
              {
                "name": "product_id",
                "value": "",
                "type": "path",
                "description": "Trading pair identifier such as BTC-USD"
              }
            ]
          },
          "docs": "Retrieves detailed information about a single product by its product ID. Returns trading pair details, limits, and current status."
        },
        {
          "info": {
            "name": "Get product order book",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/products/:product_id/book",
            "params": [
              {
                "name": "product_id",
                "value": "",
                "type": "path",
                "description": "Trading pair identifier such as BTC-USD"
              },
              {
                "name": "level",
                "value": "",
                "type": "query",
                "description": "Order book detail level (1, 2, or 3)"
              }
            ]
          },
          "docs": "Retrieves the order book for a product. The default level is 1 which returns the best bid and ask. Level 2 returns the top 50 bids and asks. Level 3 is not recommended for polling."
        },
        {
          "info": {
            "name": "Get product ticker",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/products/:product_id/ticker",
            "params": [
              {
                "name": "product_id",
                "value": "",
                "type": "path",
                "description": "Trading pair identifier such as BTC-USD"
              }
            ]
          },
          "docs": "Retrieves snapshot information about the last trade, best bid/ask, and 24-hour volume for a product."
        },
        {
          "info": {
            "name": "Get product trades",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/products/:product_id/trades",
            "params": [
              {
                "name": "product_id",
                "value": "",
                "type": "path",
                "description": "Trading pair identifier such as BTC-USD"
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination (newer items)"
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination (older items)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results per request (max 100)"
              }
            ]
          },
          "docs": "Retrieves a list of the latest trades for a product. Returns the trade ID, price, size, and time for each trade."
        },
        {
          "info": {
            "name": "Get product candles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/products/:product_id/candles",
            "params": [
              {
                "name": "product_id",
                "value": "",
                "type": "path",
                "description": "Trading pair identifier such as BTC-USD"
              },
              {
                "name": "start",
                "value": "",
                "type": "query",
                "description": "Start time in ISO 8601 format"
              },
              {
                "name": "end",
                "value": "",
                "type": "query",
                "description": "End time in ISO 8601 format"
              },
              {
                "name": "granularity",
                "value": "",
                "type": "query",
                "description": "Candle granularity in seconds"
              }
            ]
          },
          "docs": "Retrieves historical OHLCV candle data for a product. Each candle represents market activity during a specific time period."
        },
        {
          "info": {
            "name": "Get product 24hr stats",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/products/:product_id/stats",
            "params": [
              {
                "name": "product_id",
                "value": "",
                "type": "path",
                "description": "Trading pair identifier such as BTC-USD"
              }
            ]
          },
          "docs": "Retrieves 24-hour statistics for a product including open, high, low, and volume."
        }
      ]
    },
    {
      "info": {
        "name": "Currencies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List currencies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/currencies"
          },
          "docs": "Retrieves a list of all known currencies on the exchange, including their names, minimum sizes, and status."
        },
        {
          "info": {
            "name": "Get currency",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/currencies/:currency_id",
            "params": [
              {
                "name": "currency_id",
                "value": "",
                "type": "path",
                "description": "Currency identifier"
              }
            ]
          },
          "docs": "Retrieves information about a single currency by its currency ID."
        }
      ]
    },
    {
      "info": {
        "name": "Deposits",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Deposit from payment method",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.exchange.coinbase.com/deposits/payment-method",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Deposits funds from a payment method into the exchange account."
        },
        {
          "info": {
            "name": "Deposit from Coinbase account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.exchange.coinbase.com/deposits/coinbase-account",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Deposits funds from a Coinbase account into the exchange account."
        },
        {
          "info": {
            "name": "List payment methods",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/payment-methods"
          },
          "docs": "Retrieves a list of payment methods linked to the authenticated user."
        }
      ]
    },
    {
      "info": {
        "name": "Withdrawals",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Withdraw to payment method",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.exchange.coinbase.com/withdrawals/payment-method",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Withdraws funds from the exchange account to a linked payment method."
        },
        {
          "info": {
            "name": "Withdraw to Coinbase account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.exchange.coinbase.com/withdrawals/coinbase-account",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Withdraws funds from the exchange account to a Coinbase account."
        },
        {
          "info": {
            "name": "Withdraw to crypto address",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.exchange.coinbase.com/withdrawals/crypto",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Withdraws funds from the exchange account to an external crypto address."
        }
      ]
    },
    {
      "info": {
        "name": "Conversions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create conversion",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.exchange.coinbase.com/conversions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Converts funds from one stablecoin currency to another within the exchange account."
        },
        {
          "info": {
            "name": "Get conversion",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/conversions/:conversion_id",
            "params": [
              {
                "name": "conversion_id",
                "value": "",
                "type": "path",
                "description": "Conversion ID"
              }
            ]
          },
          "docs": "Retrieves the details of a specific conversion by its conversion ID."
        }
      ]
    },
    {
      "info": {
        "name": "Fees",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get fees",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/fees"
          },
          "docs": "Retrieves the current maker and taker fee rates for the authenticated user based on their trading volume."
        }
      ]
    },
    {
      "info": {
        "name": "Profiles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List profiles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/profiles",
            "params": [
              {
                "name": "active",
                "value": "",
                "type": "query",
                "description": "Filter for active profiles only"
              }
            ]
          },
          "docs": "Retrieves a list of trading profiles for the authenticated user. Profiles are used to separate trading activity."
        },
        {
          "info": {
            "name": "Get profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.coinbase.com/profiles/:profile_id",
            "params": [
              {
                "name": "profile_id",
                "value": "",
                "type": "path",
                "description": "Profile ID"
              }
            ]
          },
          "docs": "Retrieves a single profile by its profile ID."
        },
        {
          "info": {
            "name": "Transfer between profiles",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.exchange.coinbase.com/profiles/transfer",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Transfers an amount of currency from one profile to another."
        }
      ]
    }
  ],
  "bundled": true
}